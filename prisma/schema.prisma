// Wovn Rugs — data model
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Pooled connections (PgBouncer/Neon) for the app; a direct connection for
  // migrations, which cannot run through a transaction pooler.
  directUrl = env("DIRECT_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  heroImage   String?
  // SEO
  metaTitle       String?
  metaDescription String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String  @id @default(cuid())
  sku         String  @unique
  name        String
  slug        String  @unique
  shortDesc   String?
  description String?

  // Merchandising
  price        Int     // in paise (smallest currency unit)
  compareAt    Int?    // MRP for strike-through
  currency     String  @default("INR")
  stock        Int     @default(0)
  isActive     Boolean @default(true)
  isFeatured   Boolean @default(false)

  // Rug attributes (used for faceted filtering + structured data)
  material    String?  // Wool, Silk, Wool & Viscose, Jute
  technique   String?  // Hand-Knotted, Hand-Tufted, Flatweave, Hand-Loom
  style       String?  // Traditional, Transitional, Modern, Vintage
  colorFamily String?  // Ivory, Blue, Grey, Rust, Multi
  shape       String?  // Rectangle, Round, Runner, Square
  sizeLabel   String?  // 8' x 10'
  widthCm     Int?
  lengthCm    Int?
  pileHeight  String?
  knotsPerSqIn Int?
  originCity  String?  @default("Jaipur, India")
  weightGrams Int?

  // SEO
  metaTitle       String?
  metaDescription String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  images     ProductImage[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([material, technique, style])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId])
}

model Order {
  id            String  @id @default(cuid())
  orderNumber   String  @unique
  status        String  @default("PENDING")   // PENDING | PAID | FAILED | PROCESSING | SHIPPED | DELIVERED | CANCELLED | REFUNDED
  paymentStatus String  @default("UNPAID")    // UNPAID | PAID | FAILED | REFUNDED

  // Customer
  email     String
  firstName String
  lastName  String
  phone     String

  // Shipping address
  address1 String
  address2 String?
  city     String
  state    String
  postcode String
  country  String @default("India")

  // Money — all integers in paise
  subtotal    Int
  shippingFee Int @default(0)
  taxAmount   Int @default(0)
  discount    Int @default(0)
  total       Int
  currency    String @default("INR")

  // Payment (XPay)
  paymentProvider String? @default("xpay")
  xpayOrderId     String?
  xpayPaymentId   String?
  xpaySignature   String?
  paymentRaw      String?  // JSON blob of gateway response

  trackingNumber String?
  carrier        String?
  notes          String?

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Snapshot at purchase time
  name      String
  sku       String
  sizeLabel String?
  image     String?
  unitPrice Int
  quantity  Int
  lineTotal Int

  @@index([orderId])
}

model Post {
  id       String  @id @default(cuid())
  title    String
  slug     String  @unique
  excerpt  String?
  content  String            // Markdown-ish rich text
  coverImage String?
  author   String  @default("Wovn Rugs")
  tags     String? // comma separated
  isPublished Boolean @default(false)
  publishedAt DateTime?

  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, publishedAt])
}

model Enquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
