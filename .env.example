# ---------- Core ----------
# Must match the origin you actually serve from — canonicals, OG tags, the
# sitemap and the XPay return/webhook URLs are all built from it.
NEXT_PUBLIC_SITE_URL="https://www.wovnrugs.com"
NEXT_PUBLIC_SITE_NAME="Wovn Rugs"

# ---------- Database (PostgreSQL) ----------
# DATABASE_URL is the pooled connection used by the app.
# DIRECT_URL is an unpooled connection used only for migrations — a transaction
# pooler cannot run them. With Neon/Vercel Postgres, use the "pooled" and
# "unpooled"/"direct" strings respectively. Without a pooler, set both the same.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# ---------- Admin login ----------
ADMIN_EMAIL="admin@wovnrugs.com"
ADMIN_PASSWORD="change-me-to-something-long"
# 32+ random characters. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string-min-32-chars"

# ---------- XPay payment gateway ----------
XPAY_MODE="test"                       # mock | test | live
XPAY_BASE_URL="https://api.xpay.co.in"
XPAY_MERCHANT_ID=""
XPAY_API_KEY=""
XPAY_SALT=""                           # HMAC-SHA256 checksum key
XPAY_WEBHOOK_SECRET=""

# ---------- Image uploads ----------
# Set automatically when you attach a Vercel Blob store to the project.
# Left empty locally, uploads fall back to public/uploads on disk.
# BLOB_READ_WRITE_TOKEN=""

# ---------- Store ----------
STORE_CURRENCY="INR"
FREE_SHIPPING_ABOVE="15000"
FLAT_SHIPPING_FEE="499"
GST_PERCENT="12"
